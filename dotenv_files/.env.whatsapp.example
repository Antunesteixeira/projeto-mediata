# Modelo de referência. ./whatsapp.sh prepare gera credenciais próprias.
# Não carregue este modelo com os placeholders em um ambiente real.
EVOLUTION_MODE=development
EVOLUTION_ENABLED=true
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=__GENERATED_API_KEY__
EVOLUTION_DB_PASSWORD=__GENERATED_DATABASE_PASSWORD__
EVOLUTION_WEBHOOK_BASE_URL=http://mediataapp:8000
EVOLUTION_API_TIMEOUT=10
EVOLUTION_DOCKER_NETWORK=mediata-local_default
EVOLUTION_MEMORY_LIMIT=768m
