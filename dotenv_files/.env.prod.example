# ============================================================
# CONFIGURAÇÕES DE PRODUÇÃO - MEDIATA
# ============================================================
# ⚠️ NUNCA commitar este arquivo no Git!
# Copie este template e preencha com valores reais

# ========== DJANGO ==========
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com

# ========== DATABASE ==========
POSTGRES_HOST=psql
POSTGRES_PORT=5432
POSTGRES_DB=mediata_db
POSTGRES_USER=mediata_user
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://mediata_user:change-this-strong-password@psql:5432/mediata_db

# ========== SEGURANÇA ==========
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ========== EMAIL (SMTP) ==========
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
DEFAULT_FROM_EMAIL=noreply@seu-dominio.com

# ========== BACKUP & STORAGE ==========
# Google Cloud Storage
GCP_PROJECT_ID=seu-gcp-project-id
GCS_BACKUP_BUCKET=gs://mediata-backups
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json

# Backup local
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=daily  # daily, weekly, monthly

# ========== LOGS & MONITORING ==========
SENTRY_DSN=https://seu-sentry-key@sentry.io/project-id
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_DIR=/var/log/mediata

# ========== PERFORMANCE ==========
REDIS_URL=redis://redis:6379/0  # Opcional: se usar Redis
CELERY_BROKER_URL=redis://redis:6379/1  # Opcional: se usar Celery
DJANGO_SETTINGS_MODULE=mediata.settings

# ========== DESENVOLVEDOR ==========
# Para troubleshooting (NÃO use em prod se não souber!)
VERBOSE_LOGGING=False
ENABLE_DEBUG_TOOLBAR=False

# ========== TIMEZONE ==========
TZ=America/Sao_Paulo

# ========== APLICAÇÃO ==========
ENVIRONMENT=production
SITE_NAME=Mediata
SITE_URL=https://seu-dominio.com
